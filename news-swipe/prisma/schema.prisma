// datasource and generator
 datasource db {
	provider = "sqlite"
	url      = env("DATABASE_URL")
 }

 generator client {
	provider = "prisma-client-js"
 }

 // models
 model User {
	id            String   @id @default(cuid())
	email         String   @unique
	name          String?
	passwordHash  String
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt
	votes         Vote[]
	score         Int      @default(0)
	customCards   CustomCard[] @relation("UserCards")
	sessions      Session[]
 }

 model Session {
	id           String   @id @default(cuid())
	userId       String
	sessionToken String   @unique
	expires      DateTime
	user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@index([userId])
 }

 model Article {
	id          String   @id @default(cuid())
	title       String
	summary     String
	url         String
	imageUrl    String?
	source      String?
	publishedAt DateTime?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	votes       Vote[]
	likeCount   Int      @default(0)
	dislikeCount Int     @default(0)
 }

 model CustomCard {
	id          String   @id @default(cuid())
	title       String
	description String
	imageUrl    String?
	createdAt   DateTime @default(now())
	createdById String
	createdBy   User     @relation("UserCards", fields: [createdById], references: [id], onDelete: Cascade)
	votes       Vote[]
	likeCount   Int      @default(0)
	dislikeCount Int     @default(0)
	// Stripe references
	paymentStatus String  @default("unpaid") // unpaid|paid
	checkoutSessionId String? @unique
 }

 model Vote {
	id           String   @id @default(cuid())
	createdAt    DateTime @default(now())
	userId       String
	articleId    String?
	customCardId String?
	liked        Boolean
	user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
	article      Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
	customCard   CustomCard? @relation(fields: [customCardId], references: [id], onDelete: Cascade)
	@@unique([userId, articleId])
	@@unique([userId, customCardId])
	@@index([articleId])
	@@index([customCardId])
 }