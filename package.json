{
  "name": "ovall-android",
  "version": "1.0.0",
  "description": "Ovall - Wikipedia Swiping Game for Android",
  "main": "index.js",
  "scripts": {
    "build": "cordova platform add android && cordova build android",
    "serve": "cordova serve",
    "run": "cordova run android",
    "postinstall": "cordova platform add android"
  },
  "keywords": [
    "wikipedia",
    "game",
    "mobile",
    "android"
  ],
  "author": "Ovall Team",
  "license": "MIT",
  "dependencies": {
    "cordova": "^12.0.0"
  },
  "devDependencies": {
    "cordova-android": "^14.0.1"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-whitelist": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-device": {},
      "cordova-plugin-network-information": {}
    }
  }
}
